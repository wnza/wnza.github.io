{
  "manifest_version": 3,
  "name": "原地打开 · 分屏伴侣",
  "version": "1.1.0",
  "description": "把虎牙/抖音/B站上 target=_blank 的链接改成原地跳转，并把当前地址回报给 split-view.html，让它的地址栏跟着变。",
  "host_permissions": [
    "*://*.huya.com/*",
    "*://*.douyin.com/*",
    "*://live.douyin.com/*",
    "*://*.bilibili.com/*",
    "*://*.zhihu.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.weibo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.huya.com/*",
        "*://*.douyin.com/*",
        "*://live.douyin.com/*",
        "*://*.bilibili.com/*",
        "*://*.zhihu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.weibo.com/*"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "js": ["content.js"]
    },
    {
      "matches": [
        "*://*.huya.com/*",
        "*://*.douyin.com/*",
        "*://live.douyin.com/*",
        "*://*.bilibili.com/*",
        "*://*.zhihu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.weibo.com/*"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "world": "MAIN",
      "js": ["main.js"]
    }
  ]
}
